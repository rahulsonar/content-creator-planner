# Database
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/content_planner_db"

# AI API Keys (Required when USE_DUMMY_AI=false)
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"  # Optional: for claude-* models

# Security
JWT_SECRET="your-very-secure-secret-key-here-change-this-in-production"
INTERNAL_API_SECRET="default-internal-secret-change-me"

# AI Configuration
# Set to true to use dummy AI responses (no API calls, no cost)
# Set to false to use real AI models
USE_DUMMY_AI="false"

# Enable OpenAI function calling tools
ENABLE_OPENAI_TOOLS="true"

# Use the iterative Plan -> Execute -> Synthesize -> Replan workflow
USE_WORKFLOW_ORCHESTRATOR="false"
MAX_WORKFLOW_ITERATIONS="3"

# Agent Model Configuration
# Supported models: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o, etc.
PLANNER_MODEL="gpt-4"
TASK_MANAGER_MODEL="gpt-4"
CONTEXT_MANAGER_MODEL="gpt-4"

# Environment
NODE_ENV="development"
ENVIRONMENT="development"
