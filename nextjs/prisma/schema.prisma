// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Store hashed password (e.g., using bcrypt)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  
  // Hierarchical structure
  parentId    String?
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]   @relation("TaskHierarchy")
  
  // Task dependencies
  dependsOn   TaskDependency[] @relation("DependentTask")
  blockedBy   TaskDependency[] @relation("BlockingTask")
  
  // AI-related fields
  aiGenerated Boolean  @default(false)
  aiSuggestions String? @db.Text
  aiContext   String?  @db.Text
  
  // Metadata
  tags        String[]
  assignedTo  String?
  estimatedHours Float?
  actualHours    Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@index([dueDate])
}

model TaskDependency {
  id            String   @id @default(cuid())
  dependentId   String
  blockingId    String
  dependencyType DependencyType @default(FINISH_TO_START)
  
  dependent     Task     @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  blocking      Task     @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([dependentId, blockingId])
  @@index([dependentId])
  @@index([blockingId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  messages  Json     // Array of {role: 'user'|'assistant', content: string, timestamp: DateTime}
  metadata  Json?    // Additional context like referenced tasks, files, etc.
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

model UserContext {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences Json?    // User preferences, settings, theme, etc.
  workspace   Json?    // Current workspace state, open files, etc.
  aiSettings  Json?    // AI behavior preferences, model settings, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  
}

model ContextManagerConversation {
  id              String   @id @default(cuid())
  userId          String
  conversationId  String?  // Optional: link to parent Conversation if applicable
  agentName       String   @default("context_manager")
  
  // Message content
  userMessage     String   @db.Text
  assistantMessage String?  @db.Text
  
  // Tool execution logs
  toolCalls       Json?    // Array of {name, arguments, timestamp}
  toolResults     Json?    // Array of {tool_call_id, result, success, timestamp}
  
  // Metadata
  metadata        Json?    // Additional context: model used, tokens, duration, etc.
  status          ConversationStatus @default(COMPLETED)
  errorMessage    String?  @db.Text
  
  // Timestamps
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([conversationId])
  @@index([agentName])
  @@index([startedAt])
}

enum ConversationStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
