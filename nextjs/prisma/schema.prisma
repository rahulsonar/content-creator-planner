// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Store hashed password (e.g., using bcrypt)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks     Task[]
  projects  Project[]

  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  status      ProjectStatus @default(ACTIVE)
  isDefault   Boolean  @default(false)
  
  // Project timeline
  startDate   DateTime?
  endDate     DateTime?
  dueDate     DateTime?
  
  // User association
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relations
  tasks       Task[]
  
  // Metadata
  color       String?  // Hex color code for UI
  icon        String?  // Icon name or emoji
  tags        String[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Task {
  id          Int      @id @default(autoincrement())
  taskKey     String?  @unique // Human-friendly key like "CP-001"
  title       String
  description String?  @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  
  // User association
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Project association
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Hierarchical structure
  parentId    Int?
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]   @relation("TaskHierarchy")
  
  // Task dependencies
  blockedBy   TaskDependency[] @relation("DependentTask")
  blocks      TaskDependency[] @relation("BlockingTask")
  
  // Task notes
  notes       TaskNote[]
  
  // AI-related fields
  aiGenerated Boolean  @default(false)
  aiSuggestions String? @db.Text
  aiContext   String?  @db.Text
  
  // Metadata
  tags        String[]
  assignedTo  String?
  estimatedHours Float?
  actualHours    Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  createdBy String?  // User ID who created the note
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([taskId])
  @@index([createdAt])
}

model TaskDependency {
  id            String   @id @default(cuid())
  dependentId   Int
  blockingId    Int
  
  dependent     Task     @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  blocking      Task     @relation("BlockingTask", fields: [blockingId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  
  @@unique([dependentId, blockingId])
  @@index([dependentId])
  @@index([blockingId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  messages  Json     // Array of {role: 'user'|'assistant', content: string, timestamp: DateTime}
  metadata  Json?    // Additional context like referenced tasks, files, etc.
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

model UserContext {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences Json?    // User preferences, settings, theme, etc.
  workspace   Json?    // Current workspace state, open files, etc.
  aiSettings  Json?    // AI behavior preferences, model settings, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  
}

model AgentCallLog {
  id                String   @id @default(cuid())
  
  // Identification
  userId            String
  conversationId    String?  // Link to parent conversation
  messageId         String   // Unique ID for this user message (can be same across multiple agent calls)
  sessionId         String?  // Optional: broader session identifier
  
  // Agent Information
  agentName         String   // e.g., "planner", "task_manager", "context_manager"
  agentType         String?  // e.g., "planning", "task_management", "context_extraction"
  agentVersion      String?  // Track agent version for debugging
  
  // Model Information
  modelName         String   // e.g., "gpt-4", "gpt-3.5-turbo"
  modelProvider     String   @default("openai")
  
  // Call Details
  inputMessage      String?  @db.Text  // The input/prompt sent to agent
  outputMessage     String?  @db.Text  // The response from agent
  
  // Tool/Function Calls
  toolsEnabled      Boolean  @default(false)
  toolCalls         Json?    // Array of {name, arguments, timestamp, call_id}
  toolResults       Json?    // Array of {call_id, result, success, error, timestamp}
  toolCallsDetailed Json?    // Complete tool execution details: {tool_call_id, name, input, output, exception, started_at, completed_at, duration_ms, success}
  
  // Execution Metrics
  status            AgentCallStatus @default(IN_PROGRESS)
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  durationMs        Int?     // Duration in milliseconds
  
  // Token Usage (if available)
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  
  // Error Tracking
  error             String?  @db.Text
  errorType         String?  // e.g., "api_error", "tool_error", "validation_error"
  stackTrace        String?  @db.Text
  
  // Metadata
  metadata          Json?    // Additional context: parent agent, delegation info, etc.
  tags              String[] // For filtering/categorization
  
  // Audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([conversationId])
  @@index([messageId])
  @@index([agentName])
  @@index([status])
  @@index([startedAt])
  @@index([sessionId])
}

enum AgentCallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}
